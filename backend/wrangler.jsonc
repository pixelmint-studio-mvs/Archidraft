{
  "name": "archidraft-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archidraft_db",
      "database_id": "local-db-id"
    }
  ]
}
